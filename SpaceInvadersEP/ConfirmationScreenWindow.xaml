<Window x:Class="SpaceInvadersEP.ConfirmationScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SpaceInvadersEP"
        mc:Ignorable="d"
        Title="ConfirmationScreen" Height="200" Width="400" Background="Black" WindowStartupLocation="CenterScreen">
    
    
    <Grid>
        
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="25" Foreground="MediumPurple" FontWeight="Bold" Margin="0,20,0,0">
            Jogo Finalizado!
        </TextBlock>
        
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20" Foreground="WhiteSmoke" Margin="0,60,0,0">
            Deseja salvar seu score?
        </TextBlock>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="btnSim" Content="Sim" Width="100" Height="40" FontSize="15" FontWeight="Bold" Click="BtnSim_Click" Margin="-150,70,0,0" Foreground="WhiteSmoke" Background="Purple"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="btnNao" Content="Não" Width="100" Height="40" FontSize="15" FontWeight="Bold" Click="BtnNao_Click" Margin="150,70,0,0" Foreground="WhiteSmoke" Background="Purple"/>
        </StackPanel>
        
        
        
        
    </Grid>
    
    
</Window>
