<Window x:Class="SpaceInvadersEP.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SpaceInvadersEP"
        mc:Ignorable="d"
        Title="Space Invaders" Height="768" Width="1024"
        KeyDown="Window_KeyDown" Focusable="True"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Grid>
        <!-- A primeira camada é o Canvas, onde o jogo acontecerá -->
        <Canvas Name="GameCanvas" Background="Black" SizeChanged="GameCanvas_SizeChanged">
            <!-- Aqui podem ir os elementos do jogo, como naves e inimigos -->
            
        </Canvas>
        
        <!-- Bloco de texto para a pontuação no canto esquerdo -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,10,0,0">
            <TextBlock Name="ScoreText" Foreground="HotPink" FontFamily="Impact" FontSize="20" Text="Score: " />
            <TextBlock Name="ScoreValue" Foreground="HotPink" FontFamily="Impact" FontSize="20" Text="0" Margin="5,0,0,0" />
        </StackPanel>

        <!-- Quantidade de vidas no canto direito -->
        <Label x:Name="vidasLabel" Content="Lives: 3" Foreground="HotPink" FontFamily="Impact" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="20" Margin="10"/>

        <!-- Mensagem de derrota -->
        <TextBlock x:Name="DefeatMessage" 
                   Text="Game Over! 🎮❌" 
                   Visibility="Collapsed" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontSize="70" 
                   Foreground="Crimson"
                   FontFamily="Impact"
                   FontWeight="Bold"
                   TextAlignment="Center" />
        
        <!-- Mensagem de Next Level (inicialmente invisível) -->
        <TextBlock x:Name="NextLevelMessage" 
                   Text="Next Level" 
                   Visibility="Collapsed"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontSize="50" 
                   Foreground="LightCyan" 
                   FontFamily="Impact"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   />

        <!-- ~1~ Mensagem de vitória @1@ -->
        <!-- <TextBlock Name="VictoryMessage"  -->
        <!--            Text="You Won! 🎮🏆"  -->
        <!--            Visibility="Collapsed"  -->
        <!--            HorizontalAlignment="Center"  -->
        <!--            VerticalAlignment="Center"  -->
        <!--            Foreground="GreenYellow"  -->
        <!--            FontFamily="Impact"  -->
        <!--            FontSize="70" -->
        <!--            FontWeight="Bold" -->
        <!--            TextAlignment="Center" /> -->
        
    </Grid>
</Window>