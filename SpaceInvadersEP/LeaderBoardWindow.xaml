<Window x:Class="SpaceInvadersEP.LeaderBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SpaceInvadersEP"
        mc:Ignorable="d"
        Title="LeaderBoardWindow" Height="768" Width="1024">
    
    <Window.Background>
        <ImageBrush ImageSource="Images\backgroundInicial.png" Stretch="UniformToFill"/>
    </Window.Background>
    
    <Grid>
        
        <!-- Opção 1 Clean (sem imagem) -->
        <Border Height="2" Background="#00D4B3" VerticalAlignment="Top" Width="350" Margin="0,30,0,0"/>
        <TextBlock Text="LeaderBoard" HorizontalAlignment="Center" FontSize="55" FontFamily="Impact" Foreground="LightPink" Margin="0,32,0,0"/>
        <Border Height="2" Background="#00D4B3" VerticalAlignment="Top" Width="350" Margin="0,100,0,0"/>
        
        
        
        
        
        
        
        
    </Grid>
</Window>
