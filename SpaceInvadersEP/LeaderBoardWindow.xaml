<Window x:Class="SpaceInvadersEP.LeaderBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SpaceInvadersEP"
        mc:Ignorable="d"
        Title="LeaderBoardWindow" Height="768" Width="1024">
    
    <Window.Background>
        <ImageBrush ImageSource="Images\backgroundInicial.png" Stretch="UniformToFill"/>
    </Window.Background>

    
    <Grid>
        
        <!-- Opção 1 Clean (sem imagem) -->
        <Border Height="2" Background="#00D4B3" VerticalAlignment="Top" Width="350" Margin="0,30,0,0"/>
        <TextBlock Text="LeaderBoard" HorizontalAlignment="Center" FontSize="55" FontFamily="Impact" Foreground="LightPink" Margin="0,32,0,0"/>
        <Border Height="2" Background="#00D4B3" VerticalAlignment="Top" Width="350" Margin="0,100,0,0"/>

        
        <ListView Name="leaderboardListView" Height="500" Width="600" FontFamily="Impact" FontSize="20" Foreground="GhostWhite" Margin="0,50,0,0">
            
            <!-- <ListView.Background> -->
            <!--     ~1~ Cor de fundo do ListView rosa clarinho @1@ -->
            <!--     ~1~ <SolidColorBrush Color="MistyRose"/> @1@ -->
            <!--     <SolidColorBrush Color="MintCream"/> -->
            <!-- </ListView.Background> -->
            
            <ListView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.5">
                    <!-- Definir as cores do degradê -->
                    <GradientStop Color="CadetBlue" Offset="0" />
                    <GradientStop Color="Pink" Offset="1" />
                </LinearGradientBrush>
            </ListView.Background>
            
            
            <ListView.View>
                <GridView> 
            
                    <!-- Nova coluna para exibir o Ranking -->
                    <GridViewColumn Header="Ranking" DisplayMemberBinding="{Binding Ranking}" Width="150" />
                    <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Nome}" Width="300" />
                    <GridViewColumn Header="Score" DisplayMemberBinding="{Binding Score}" Width="150"/>
            </GridView>
            </ListView.View>
            
            
            
        </ListView>
        
        
        <!-- <TextBox Text="Nome" Width="55" Height="30" FontSize="20" FontFamily="Impact" BorderThickness="0" Foreground="WhiteSmoke" Background="Transparent" Margin="0,0,188,415" /> -->
        <!-- -->
        <!-- -->
        <!-- <TextBox Text="Score" Width="55" Height="30" FontSize="20" FontFamily="Impact" BorderThickness="0" Foreground="WhiteSmoke" Background="Transparent" Margin="411,0,0,415" /> -->
        
    </Grid>
    
    
</Window>
