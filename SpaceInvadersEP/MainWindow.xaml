<Window x:Class="SpaceInvadersEP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceInvadersEP"
        mc:Ignorable="d"
        Title="MainWindow" Height="768" Width="1024">
    
    <Window.Background>
        <ImageBrush ImageSource="Images\backgroundInicial.png" Stretch="UniformToFill"/>
    </Window.Background>
    
    
    <Grid>
        
        <!-- Controle Image com tamanho ajustado -->
        <Image Source="Images\title.png" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" 
               Margin="0,-250,0,0" 
               Width="500" Height="150"/>
        
        
        <!--  Botão Iniciar  -->
        <Button Content="StartGame" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="50" FontSize="25" FontFamily="Impact" Click="IniciarButton_StartGame" Margin="0,0,0,0"/>
        
        <!--  Botão Iniciar  -->
        <Button Content="LeaderBoard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="50" FontSize="25" FontFamily="Impact" Click="IniciarButton_LeaderBoard" Margin="0,150,0,0"/>
        
        <!--  Botão Iniciar  -->
        <Button Content="Game Controls" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="50" FontSize="25" FontFamily="Impact" Click="IniciarButton_GameControls" Margin="0,300,0,0"/>

    </Grid>
    
    <Window.Resources>
        <Style TargetType="Button">
            <!-- <Setter Property="Background" Value="#4CAF98"/> -->
            <Setter Property="Background" Value="#212121"/>
            <Setter Property="Foreground" Value="Pink"/>
        </Style>
    </Window.Resources>
    
</Window>
